# Build inputs read by the patch (patch/) when built inside TB321FU-GSI-Mods.
# Defaults are set in Mods devices/<device>/conf.d/tango.conf; a variable set in the environment overrides it.

# Optional. Directory of the Tango v2.1.0 integration package; must contain prebuilts/tango_translator. Component: 001.core
TANGO_PKG=/path/to/tango/pkg

# Optional. tango32.ko built for the device kernel. Component: 003.kernel-module
TANGO32_KO=/path/to/tango32.ko

# Optional. Kernel release string; must equal the first field of the module vermagic. Component: 003.kernel-module
TANGO_KERNEL_RELEASE=6.1.112-android14-11-gd03cb1d7abcd-ab12592111

# Optional. Directory laid out like /vendor/lib holding the 30 files in manifest.sha256. Component: 004.vendor-lib32
XIAOMI_LIB32_DIR=/path/to/xiaomi-vendor-lib32

# Optional. Translator log level: off, info or debug. Component: 001.core
TANGO_DEBUG=off
